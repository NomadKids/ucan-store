(ucan_store_routes) {
  encode zstd gzip

  header {
    Access-Control-Allow-Origin "*"
    Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS"
    Access-Control-Allow-Headers "Content-Type, Authorization, X-Amz-Checksum-Sha256"
  }

  @options method OPTIONS
  respond @options 204

  handle /.well-known/ucan-store.json {
    root * /app/runtime
    rewrite * /.well-known/ucan-store.json
    file_server
  }

  handle /.well-known/did.json {
    root * /app/runtime
    rewrite * /.well-known/did.json
    file_server
  }

  handle /service-manifest.json {
    root * /app/runtime
    rewrite * /service-manifest.json
    file_server
  }

  handle /health {
    reverse_proxy 127.0.0.1:8790 {
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Origin
    }
  }

  handle /healthz {
    reverse_proxy 127.0.0.1:8790 {
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Origin
    }
  }

  handle /configure {
    reverse_proxy 127.0.0.1:8790 {
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Origin
    }
  }

  handle /admin/* {
    reverse_proxy 127.0.0.1:8790 {
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Origin
    }
  }

  handle_path /api/admin/* {
    rewrite * /admin{uri}
    reverse_proxy 127.0.0.1:8790 {
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Origin
    }
  }

  handle_path /api/* {
    reverse_proxy 127.0.0.1:8787
  }

  handle /ipfs/* {
    reverse_proxy 127.0.0.1:8081
  }

  handle {
    rewrite * /ipfs/{env.UCAN_STORE_UI_CID}{uri}
    reverse_proxy 127.0.0.1:8081
  }
}

:80 {
  import ucan_store_routes
}

:8080 {
  import ucan_store_routes
}

import /app/runtime/caddy-custom-domain.conf
